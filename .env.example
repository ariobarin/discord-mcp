# Your Discord account token (see README)
DISCORD_TOKEN=

# Only needed when hosting over HTTP (docker compose); local stdio use needs just the token.

# Public HTTPS URL your reverse proxy serves, e.g. https://discord.example.com
PUBLIC_URL=

# OAuth app that Claude signs in with: discord (default), github or google.
# Its redirect URL is <PUBLIC_URL>/auth/callback.
AUTH=discord
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Who may sign in, besides the Discord account above: user ids, usernames or emails
ALLOWED_USERS=

# Address and port to listen on; your reverse proxy forwards here
BIND_ADDR=127.0.0.1
PORT=8000
