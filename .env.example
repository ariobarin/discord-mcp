# Your Discord account token (see README)
DISCORD_TOKEN=

# Discord OAuth app, used only so Claude can sign in as you (see README)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public HTTPS URL your reverse proxy serves, e.g. https://discord-mcp.example.com
PUBLIC_URL=

# Host address and port the server listens on. Your reverse proxy forwards here.
BIND_ADDR=127.0.0.1
PORT=8000
